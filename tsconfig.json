{
  "compilerOptions": {
    "strict": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2025", "ESNext.Array"],
    "target": "ES2025",
    "sourceMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "vitest/globals"]
  }
}
