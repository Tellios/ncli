{
  "name": "tellios-ncli",
  "version": "0.0.1",
  "description": "Helper scripts for easing workflow",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "na": "./bin/alias",
    "ncode64": "./bin/ncode64",
    "ni": "./bin/node/ni",
    "nr": "./bin/node/nr",
    "nb": "./bin/node/nb",
    "nt": "./bin/node/nt",
    "nex": "./bin/node/nex",
    "nclone": "./bin/git/clone",
    "ncommit": "./bin/git/commit",
    "nlog": "./bin/git/log",
    "ncb": "./bin/git/createBranch",
    "ngcb": "./bin/git/getCurrentBranch",
    "ngb": "./bin/git/getBranches",
    "nmf": "./bin/git/mergeFrom",
    "nmt": "./bin/git/mergeTo",
    "nrb": "./bin/git/removeBranch",
    "nstatus": "./bin/git/status",
    "nsb": "./bin/git/switchBranch",
    "npull": "./bin/git/pull",
    "npush": "./bin/git/push",
    "nupstream": "./bin/git/setUpstream",
    "nd": "./bin/nd",
    "nk": "./bin/nk",
    "nsettings": "./bin/nsettings"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  },
  "scripts": {
    "prettier": "prettier --check --write \"{lib,src}/**/*.ts\"",
    "prettier:ci": "prettier -l \"{lib,src}/**/*.ts\"",
    "pretest": "npm run lint",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll --runInBand",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "setup": "sh -c \"unset npm_config_allow_scripts NPM_CONFIG_ALLOW_SCRIPTS; npm ci && npm run prettier && npm run test && npm run build && npm link\"",
    "lint": "npm run script:lint -- --fix",
    "lint:ci": "npm run script:lint",
    "script:lint": "xo . --max-warnings=0 --space --prettier"
  },
  "dependencies": {
    "chalk": "^4.1.0",
    "cli-table3": "^0.6.0",
    "concurrently": "^5.3.0",
    "execa": "^5.1.1",
    "fs-extra": "^9.0.1",
    "glob": "^7.1.6",
    "inquirer": "^8.2.0",
    "inquirer-autocomplete-prompt": "^1.4.0",
    "joi": "^17.6.0",
    "js-yaml": "^3.14.0",
    "lodash": "^4.17.20",
    "node-pty": "^1.1.0",
    "readline-sync": "^1.4.10",
    "tree-kill": "^1.2.2",
    "yargs": "^16.1.0"
  },
  "devDependencies": {
    "@types/cli-table2": "^0.2.2",
    "@types/concurrently": "^6.2.1",
    "@types/fs-extra": "^9.0.3",
    "@types/glob": "^7.1.3",
    "@types/inquirer": "7.3.1",
    "@types/inquirer-autocomplete-prompt": "^1.3.0",
    "@types/jest": "^28.1.0",
    "@types/js-yaml": "^3.12.5",
    "@types/lodash": "^4.14.165",
    "@types/node": "^14.14.6",
    "@types/readline-sync": "^1.4.3",
    "@types/yargs": "^15.0.9",
    "husky": "^4.3.0",
    "jest": "^28.1.0",
    "lint-staged": "^10.5.1",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "ts-jest": "^28.0.4",
    "typescript": "^7.0.2",
    "xo": "^5.0.1"
  },
  "allowScripts": {
    "husky": true,
    "node-pty": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,md}": "prettier --write",
    "*.{ts}": "xo --prettier --max-warnings 0 --fix"
  }
}
