{
  "name": "tellios-ncli",
  "version": "0.0.1",
  "private": true,
  "description": "Helper scripts for easing workflow",
  "license": "ISC",
  "author": "Tellios",
  "type": "module",
  "bin": {
    "na": "./bin/alias",
    "ncode64": "./bin/ncode64",
    "ni": "./bin/node/ni",
    "nr": "./bin/node/nr",
    "nb": "./bin/node/nb",
    "nt": "./bin/node/nt",
    "nex": "./bin/node/nex",
    "nclone": "./bin/git/clone",
    "ncommit": "./bin/git/commit",
    "nlog": "./bin/git/log",
    "ncb": "./bin/git/create-branch",
    "ngcb": "./bin/git/get-current-branch",
    "ngb": "./bin/git/get-branches",
    "nmf": "./bin/git/merge-from",
    "nmt": "./bin/git/merge-to",
    "nrb": "./bin/git/remove-branch",
    "nstatus": "./bin/git/status",
    "nsb": "./bin/git/switch-branch",
    "npull": "./bin/git/pull",
    "npush": "./bin/git/push",
    "nupstream": "./bin/git/set-upstream",
    "nd": "./bin/nd",
    "nk": "./bin/nk",
    "nsettings": "./bin/nsettings"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  },
  "scripts": {
    "prettier": "prettier --check --write \"{lib,src}/**/*.ts\"",
    "prettier:ci": "prettier -l \"{lib,src}/**/*.ts\"",
    "pretest": "pnpm run lint",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "setup": "pnpm install --frozen-lockfile && pnpm run prettier && pnpm run test && pnpm run build && pnpm link",
    "lint": "pnpm run script:lint -- --fix",
    "lint:ci": "pnpm run script:lint",
    "script:lint": "xo . --max-warnings=0"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "cli-table3": "^0.6.0",
    "concurrently": "^5.3.0",
    "es-toolkit": "^1.52.0",
    "execa": "^5.1.1",
    "fs-extra": "^11.4.1",
    "glob": "^7.1.6",
    "joi": "^17.6.0",
    "js-yaml": "^3.14.0",
    "node-pty": "^1.1.0",
    "readline-sync": "^1.4.10",
    "tree-kill": "^1.2.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/concurrently": "^6.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^7.1.3",
    "@types/js-yaml": "^3.12.5",
    "@types/node": "^26.6.5",
    "@types/readline-sync": "^1.4.3",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-config-xo-space": "^1.0.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.5.1",
    "prettier": "^3.9.10",
    "rimraf": "^3.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "xo": "^5.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,md}": "prettier --write",
    "*.{ts}": "xo --max-warnings 0 --fix"
  }
}
